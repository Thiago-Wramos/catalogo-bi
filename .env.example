# Copie este arquivo para ".env" e troque TODOS os valores.
# O .env NUNCA vai para o Git (ver .gitignore).

MYSQL_ROOT_PASSWORD=troque_senha_root
MYSQL_DATABASE=catalogo
MYSQL_USER=catalogo_app
MYSQL_PASSWORD=troque_senha_app

# Confira a versão estável mais recente em https://github.com/qdrant/qdrant/releases
QDRANT_VERSION=v1.17.0
QDRANT_API_KEY=troque_por_uma_chave_longa
