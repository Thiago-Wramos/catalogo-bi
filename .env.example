# Copie este arquivo para ".env" e troque TODOS os valores de senha e chave.
# O .env NUNCA vai para o Git (ver .gitignore) nem para a imagem Docker (ver .dockerignore).

# --- MySQL
MYSQL_ROOT_PASSWORD=troque_senha_root
MYSQL_DATABASE=catalogo
MYSQL_USER=catalogo_app
MYSQL_PASSWORD=troque_senha_app

# --- Qdrant
# Use a mesma série (1.xx) da biblioteca qdrant-client do requirements.txt.
# Versões: https://github.com/qdrant/qdrant/releases
QDRANT_VERSION=v1.19.0
QDRANT_API_KEY=troque_por_uma_chave_longa

# Endereço usado pelos scripts que rodam FORA do Docker (carga, indexação, bateria).
# Use 127.0.0.1, não "localhost": no Windows, "localhost" tenta IPv6 primeiro e cada
# conexão atrasa ~2 s. Dentro do Docker, o docker-compose substitui este valor.
QDRANT_URL=http://127.0.0.1:6333

# --- Ajustes opcionais (os valores abaixo são os padrões; descomente para mudar)
# CHAT_MODEL=qwen3.5:9b
# EMBEDDING_MODEL=bge-m3
# SCORE_MINIMO=0.45
# MARGEM_RELEVANCIA=0.05
# LIMIAR_INTENCAO=0.70
# POLITICA_SEM_ACESSO=indicar      # ou "neutra"
